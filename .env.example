# ─────────────────────────────────────────────────────────────
# CivicResolve — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local (or .env.*.local) to source control.
# ─────────────────────────────────────────────────────────────

# ── Database (Supabase / PostgreSQL) ──────────────────────────
# REQUIRED — Pooled connection string for Prisma (pgBouncer)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# REQUIRED — Direct connection string (migrations; bypasses pgBouncer)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ── Auth.js v5 ─────────────────────────────────────────────────
# REQUIRED — Generate with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"

# REQUIRED — Canonical URL of the app (no trailing slash)
AUTH_URL="http://localhost:3000"

# ── Application ────────────────────────────────────────────────
# OPTIONAL — Public site URL (defaults unused in most server paths)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# OPTIONAL — Display name
NEXT_PUBLIC_APP_NAME="CivicResolve"

# ── SLA Cron ───────────────────────────────────────────────────
# REQUIRED in any environment that exposes POST /api/cron/sla
# Send as: Authorization: Bearer <value>  OR  x-cron-secret: <value>
# Dev: set a long random string; never leave unset in production.
CRON_SECRET="your-cron-secret-here"

# ── File Storage ───────────────────────────────────────────────
# OPTIONAL — Storage backend. Currently only "local" is implemented.
# Defaults to "local" (writes under ./uploads).
STORAGE_PROVIDER="local"

# OPTIONAL — Reserved for future S3 / Supabase Storage providers
# (not wired when STORAGE_PROVIDER=local)
STORAGE_BUCKET=""
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_REGION=""

# OPTIONAL — Documented limits (app currently uses built-in 10MB + MIME allowlist
# in lib/attachments.ts; these are reserved for future env-driven config)
MAX_FILE_SIZE_BYTES="10485760"
ALLOWED_FILE_TYPES="image/jpeg,image/png,image/webp,application/pdf"

# ── Database seed (local / explicit only) ──────────────────────
# OPTIONAL — Seeds refuse to run when NODE_ENV=production unless this is "true"
ALLOW_PRODUCTION_SEED="false"

# OPTIONAL — Override demo passwords used by prisma/seed.ts (local only)
SEED_ADMIN_PASSWORD=""
SEED_MANAGER_PASSWORD=""
SEED_OFFICER_PASSWORD=""
SEED_CITIZEN_PASSWORD=""
