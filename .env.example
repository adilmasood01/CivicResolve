# ─────────────────────────────────────────────────────────────
# CivicResolve — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to source control.
# ─────────────────────────────────────────────────────────────

# ── Database (Supabase / PostgreSQL) ──────────────────────────
# Pooled connection string for Prisma (pgBouncer)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection string (used for migrations, bypasses pgBouncer)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ── Auth.js v5 ─────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"

# The canonical URL of your app (no trailing slash)
AUTH_URL="http://localhost:3000"

# ── Application ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="CivicResolve"

# ── File Storage (Phase 11) ────────────────────────────────────
# Supabase Storage or S3-compatible bucket
STORAGE_BUCKET=""
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_REGION=""

# Max file size in bytes (default: 10MB)
MAX_FILE_SIZE_BYTES="10485760"
# Allowed MIME types (comma-separated)
ALLOWED_FILE_TYPES="image/jpeg,image/png,image/webp,application/pdf"
