# ─────────────────────────────────────────────────────────────
# CivicResolve — Environment Variables
# Copy this file to `.env` and fill in your values.
# Prisma CLI loads `.env` (Next.js also accepts `.env.local` if you prefer both).
# NEVER commit `.env`, `.env.local`, or `.env.*.local` to source control.
# ─────────────────────────────────────────────────────────────

# ── Database (Supabase / PostgreSQL) ──────────────────────────
# REQUIRED — Pooled connection string for Prisma (pgBouncer)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# REQUIRED — Direct connection string (migrations; bypasses pgBouncer)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ── Auth.js v5 ─────────────────────────────────────────────────
# REQUIRED — Generate with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"

# REQUIRED — Canonical URL of the app (no trailing slash)
AUTH_URL="http://localhost:3000"

# ── Application ────────────────────────────────────────────────
# OPTIONAL — Public site URL (defaults unused in most server paths)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# OPTIONAL — Display name
NEXT_PUBLIC_APP_NAME="CivicResolve"

# ── SLA Cron ───────────────────────────────────────────────────
# REQUIRED in any environment that exposes POST /api/cron/sla
# Send as: Authorization: Bearer <value>  OR  x-cron-secret: <value>
# Dev: set a long random string; never leave unset in production.
CRON_SECRET="your-cron-secret-here"

# ── File Storage ───────────────────────────────────────────────
# ── Storage backend ───────────────────────────────────────────
# "local" (writes under ./uploads or /tmp on Vercel) or "supabase" (recommended for production)
# Automatically selects "supabase" in production if NEXT_PUBLIC_SUPABASE_URL is provided.
STORAGE_PROVIDER="local"
STORAGE_BUCKET="attachments"

# Supabase Storage credentials (required when STORAGE_PROVIDER="supabase")
# NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key" # Recommended for server routes
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# OPTIONAL — Documented limits (app currently uses built-in 10MB + MIME allowlist
# in lib/attachments.ts; these are reserved for future env-driven config)
MAX_FILE_SIZE_BYTES="10485760"
ALLOWED_FILE_TYPES="image/jpeg,image/png,image/webp,application/pdf"

# ── Database seed (local / explicit only) ──────────────────────
# OPTIONAL — Seeds refuse to run when NODE_ENV=production unless this is "true"
ALLOW_PRODUCTION_SEED="false"

# OPTIONAL — Override demo passwords used by prisma/seed.ts (local only)
SEED_ADMIN_PASSWORD=""
SEED_MANAGER_PASSWORD=""
SEED_OFFICER_PASSWORD=""
SEED_CITIZEN_PASSWORD=""
